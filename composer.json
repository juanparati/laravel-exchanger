{
    "name": "juanparati/laravel-exchanger",
    "description": "A currency exchange rate library for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Juan Lago",
            "email": "juanparati@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-simplexml": "*",
        "illuminate/cache": "^13",
        "illuminate/support": "^13",
        "php-http/guzzle7-adapter": "^0.1.1",
        "florianv/exchanger": "^2.9",
        "kevinrob/guzzle-cache-middleware": "^7.0",
        "guzzlehttp/promises": "^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "orchestra/testbench": "^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Juanparati\\LaravelExchanger\\Providers\\ExchangerServiceProvider"
            ],
            "aliases": {
                "Exchanger": "Juanparati\\LaravelExchanger\\Facades\\ExchangerConverterFacade"
            }
        }
    },
    "autoload": {
        "psr-4": {
            "Juanparati\\LaravelExchanger\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Juanparati\\LaravelExchanger\\Tests\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest"
    }
}
